#!/usr/bin/env bash
# Git pre-commit hook: runs the same lint check CI does, so a formatting or
# SwiftLint violation is caught before it leaves your machine instead of
# after a round trip through CI. Not installed automatically — run
# scripts/hooks/install.sh once to symlink this in.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
exec "$ROOT/scripts/tools.sh" lint
